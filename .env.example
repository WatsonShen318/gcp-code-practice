# Defaults reuse the original ZIP's Ping Client and Secret Manager resource.
# This file is documentation only; it is NOT automatically loaded.
AUTH_ENABLED=true
SSO_CLIENT_ID=APM0015442
USE_SECRET_MANAGER=1
GCP_PROJECT_ID=edp-pdev-restrict-paops
SECRET_ID=paops-streamlit-pdev
SECRET_VERSION=latest
# Default callback for this application, registered for the same Ping Client.
REDIRECT_URI=https://pa-caddie-demo.pdev.cvshealth.com/token
TOKEN_EXPIRATION_TIME=7200
# Dev SSO endpoints (active).
AUTH_URL=https://authsvc-dev.cvshealth.com/as/authorization.oauth2
TOKEN_ENDPOINT=https://authsvc-dev.cvshealth.com/as/token.oauth2
USERINFO_ENDPOINT=https://authsvc-dev.cvshealth.com/idp/userinfo.openid
# Prod SSO endpoints (inactive).
# AUTH_URL=https://authsvc.cvshealth.com/as/authorization.oauth2
# TOKEN_ENDPOINT=https://authsvc.cvshealth.com/as/token.oauth2
# USERINFO_ENDPOINT=https://authsvc.cvshealth.com/idp/userinfo.openid
# Optional overrides only; normally neither value needs manual injection.
# SSO_CLIENT_SECRET=  (also accepts lowercase sso_client_secret)
# SHARED_SECRET_KEY=  (otherwise a stable app-specific key is derived)
# Never commit secret values. The 11 AD groups remain fixed in ping_auth.py.
