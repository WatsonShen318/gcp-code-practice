# Configuration reference; supply values through GKE environment variables / Secrets.
# This file is NOT loaded automatically. Never commit real secret values.
AUTH_ENABLED=true
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# The reference repo's lowercase sso_client_secret is also accepted.
REDIRECT_URI=https://YOUR-APPLICATION-HOST/token
SHARED_SECRET_KEY=
TOKEN_EXPIRATION_TIME=7200
# Corporate Ping endpoints from the reference; override for another environment.
AUTH_URL=https://authsvc.cvshealth.com/as/authorization.oauth2
TOKEN_ENDPOINT=https://authsvc.cvshealth.com/as/token.oauth2
USERINFO_ENDPOINT=https://authsvc.cvshealth.com/idp/userinfo.openid
# The 11 allowed AD groups are fixed in ping_auth.py (the supplied screenshot).
