# Configuration reference only: supply these as environment variables / GKE Secrets.
# This file is NOT loaded automatically. Do not put real secrets in Git.
AUTH_ENABLED=true
AUTH_SESSION_SECRET=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
SSO_AUTHORIZE_URL=
SSO_TOKEN_URL=
SSO_USERINFO_URL=
SSO_ISSUER=
SSO_JWKS_URL=
SSO_AUDIENCE=
SSO_REDIRECT_URI=https://YOUR-APPLICATION-HOST/auth/callback
# Defaults to all 11 exact group names in access_control.py, from the screenshot.
# Set this optional variable only to override the default list (comma separated).
# AUTH_ALLOWED_GROUPS=app-paops-eng,app-paops-pnp-eng
